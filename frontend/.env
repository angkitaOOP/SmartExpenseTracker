# Works around a known CRA 5 / newer eslint-plugin-jest incompatibility
# ("Environment key jest/globals is unknown") that otherwise breaks
# `npm run build` and `npm start`. Safe to remove once react-scripts
# is upgraded past 5.0.1.
DISABLE_ESLINT_PLUGIN=true
REACT_APP_API_URL=https://smartexpensetracker-production-d71e.up.railway.app